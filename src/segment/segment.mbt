  Extend
  ZWJ
  Regional_Indicator
  Prepend
  SpacingMark
  L
  V
  T
  LV
  LVT
} derive(Eq)

///|
pub extend Gcb with Eq::{equal, not_equal}

///|
/// The Gcb value of a stored Grapheme_Cluster_Break code.
pub fn gcb_of_code(code : Int32) -> Gcb {
  match code {
    0 => Other
    1 => CR
    2 => LF
    3 => Control
    4 => Extend
    5 => ZWJ
    6 => Regional_Indicator
    7 => Prepend
    8 => SpacingMark
    9 => L
    10 => V
    11 => T
    12 => LV
    13 => LVT
    _ => Other
  }
}

