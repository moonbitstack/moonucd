import {
  "moonbitstack/moonucd",
  "moonbitstack/moonucd/age",
  "moonbitstack/moonucd/block",
  "moonbitstack/moonucd/name",
  "moonbitstack/moonucd/normalize",
  "moonbitstack/moonucd/script",
  "moonbitstack/moonucd/segment",
  "moonbitstack/moonucd/width",
  "moonbitstack/moonucd/linebreak",
}

pkgtype(kind: "executable")

// The character inspector is a browser-only demo: it wires the MoonBit functions
// onto the JavaScript global object via `extern "js"`. Those declarations only
// make sense on the JS backend, so the registration lives in backend-specific
// files. On every other backend the same functions are linked but registered as
// no-ops, which keeps `moon build --target all` green while the real inspector
// still runs in the browser.

options(
  targets: {
    "reg_js.mbt": [ "js" ],
    "reg_native.mbt": [ "native", "llvm" ],
    "reg_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
